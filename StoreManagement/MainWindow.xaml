<Window x:Class="StoreManagement.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Calvotti Market" Height="780" Width="1280" WindowStartupLocation="CenterScreen" Background="#F8FAFC">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#172554" Padding="16"><StackPanel><TextBlock Text="CALVOTTI" Foreground="White" FontSize="25" FontWeight="Bold" Margin="6,12,6,28"/>
   <Button Content="🏠  Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Content="📦  Mallar" Command="{Binding NavigateCommand}" CommandParameter="Mallar"/><Button Content="🛒  Satış" Command="{Binding NavigateCommand}" CommandParameter="Satış"/><Button Content="📥  Alış" Command="{Binding NavigateCommand}" CommandParameter="Alış"/><Button Content="💰  Gəlir / Xərc" Command="{Binding NavigateCommand}" CommandParameter="Maliyyə"/><Button Content="📊  Hesabatlar" Command="{Binding NavigateCommand}" CommandParameter="Hesabatlar"/><Button Content="⚙️  Ayarlar" Command="{Binding NavigateCommand}" CommandParameter="Ayarlar"/></StackPanel></Border>
  <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="18"/>
 </Grid>
</Window>
