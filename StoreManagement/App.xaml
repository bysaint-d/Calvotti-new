<Application x:Class="StoreManagement.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:StoreManagement.ViewModels" xmlns:helpers="clr-namespace:StoreManagement.Helpers"><Application.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/></Style><Style TargetType="DataGrid"><Setter Property="Margin" Value="8"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/></Style>
<DataTemplate DataType="{x:Type vm:DashboardVm}"><StackPanel><TextBlock Text="Dashboard" FontSize="28"/><UniformGrid Columns="3"><TextBlock Text="{Binding TodaySales,StringFormat=Bugünkü satış: {0:N2} ₼}" Margin="10" FontSize="20"/><TextBlock Text="{Binding TodayProfit,StringFormat=Bugünkü mənfəət: {0:N2} ₼}" Margin="10" FontSize="20"/><TextBlock Text="{Binding MonthSales,StringFormat=Bu ayın satışı: {0:N2} ₼}" Margin="10" FontSize="20"/></UniformGrid><DataGrid ItemsSource="{Binding Critical}"><DataGrid.Columns><DataGridTextColumn Header="Kritik məhsul" Binding="{Binding Name}"/><DataGridTextColumn Header="Stok" Binding="{Binding StockQuantity}"/></DataGrid.Columns></DataGrid></StackPanel></DataTemplate>
<DataTemplate DataType="{x:Type vm:ProductsVm}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mallar" FontSize="28" FontWeight="Bold"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="270" ToolTip="Məhsul adı, barkod və kateqoriya üzrə axtar"/><TextBox Text="{Binding BarcodeInput,UpdateSourceTrigger=PropertyChanged}" helpers:BarcodeEnterBehavior.Command="{Binding ScanCommand}" Width="180" ToolTip="USB barkod skanerini buraya oxudun"/><Button Content="Barkodu yoxla" Command="{Binding ScanCommand}"/></StackPanel><DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}"/><DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}"/><DataGridTextColumn Header="Məhsul adı" Binding="{Binding Name}"/><DataGridTextColumn Header="Kateqoriya" Binding="{Binding Category}"/><DataGridTextColumn Header="Alış" Binding="{Binding PurchasePrice,StringFormat={}{0:N2} ₼}"/><DataGridTextColumn Header="Satış" Binding="{Binding SalePrice,StringFormat={}{0:N2} ₼}"/><DataGridTextColumn Header="Stok" Binding="{Binding StockQuantity}"/><DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStock}"/></DataGrid.Columns></DataGrid></StackPanel><ScrollViewer Grid.Column="1"><StackPanel><Border Background="White" Padding="14" Margin="5"><StackPanel><TextBlock Text="Məhsul əlavə et / redaktə et" FontSize="20" FontWeight="Bold"/><TextBlock Text="Məhsul adı"/><TextBox Text="{Binding Form.Name}"/><TextBlock Text="Barkod (məcburi deyil)"/><TextBox Text="{Binding Form.Barcode}"/><TextBlock Text="Kateqoriya"/><TextBox Text="{Binding Form.Category}"/><TextBlock Text="Alış qiyməti"/><TextBox Text="{Binding Form.PurchasePrice}"/><TextBlock Text="Satış qiyməti"/><TextBox Text="{Binding Form.SalePrice}"/><TextBlock Text="İlkin / cari miqdar"/><TextBox Text="{Binding Form.StockQuantity}"/><TextBlock Text="Minimum stok"/><TextBox Text="{Binding Form.MinimumStock}"/><TextBlock Text="Təchizatçı"/><TextBox Text="{Binding Form.Supplier}"/><TextBlock Text="Qeyd"/><TextBox Text="{Binding Form.Notes}"/><Button Content="Yeni məhsul" Command="{Binding NewCommand}"/><Button Content="Yadda saxla" Command="{Binding SaveCommand}"/><Button Content="Seçilmiş məhsulu sil" Background="#DC2626" Command="{Binding DeleteCommand}"/></StackPanel></Border><Border Background="#EFF6FF" Padding="14" Margin="5"><StackPanel><TextBlock Text="Stok düzəlişi" FontSize="18"/><TextBlock Text="Müsbət rəqəm stoku artırır, mənfi rəqəm azaldır." TextWrapping="Wrap"/><TextBox Text="{Binding Adjustment}" ToolTip="Düzəliş miqdarı"/><TextBox Text="{Binding AdjustmentNote}" ToolTip="Səbəb"/><Button Content="Stoku yenilə" Command="{Binding AdjustCommand}"/></StackPanel></Border></StackPanel></ScrollViewer></Grid></DataTemplate>
<DataTemplate DataType="{x:Type vm:SalesVm}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Satış" FontSize="28" FontWeight="Bold"/><TextBlock Text="USB skaner klaviatura kimi işləyir: aşağıdakı sahəyə oxudun, Enter avtomatik əlavə edir." Foreground="#475569"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding Barcode,UpdateSourceTrigger=PropertyChanged}" helpers:BarcodeEnterBehavior.Command="{Binding ScanCommand}" Width="360" ToolTip="Barkod"/><Button Content="Əlavə et" Command="{Binding ScanCommand}"/></StackPanel></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal"><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="300" ToolTip="Məhsul axtar"/><ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" Width="280" Margin="4"/><Button Content="Seçilmiş məhsulu əlavə et" Command="{Binding AddSelectedCommand}"/></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Cart}"><DataGrid.Columns><DataGridTextColumn Header="Məhsul" Binding="{Binding Product.Name}"/><DataGridTemplateColumn Header="Say"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="−" Command="{Binding DataContext.DecreaseCommand,RelativeSource={RelativeSource AncestorType=ContentControl}}" CommandParameter="{Binding}"/><TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="45"/><Button Content="+" Command="{Binding DataContext.IncreaseCommand,RelativeSource={RelativeSource AncestorType=ContentControl}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Qiymət" Binding="{Binding Product.SalePrice,StringFormat={}{0:N2} ₼}"/><DataGridTextColumn Header="Cəmi" Binding="{Binding Total,StringFormat={}{0:N2} ₼}"/><DataGridTemplateColumn Header="Sil"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Sil" Command="{Binding DataContext.RemoveCommand,RelativeSource={RelativeSource AncestorType=ContentControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Border Grid.Row="3" Background="White" Padding="12"><WrapPanel><TextBlock Text="Ara cəm: "/><TextBlock Text="{Binding Subtotal,StringFormat={}{0:N2} ₼}"/><TextBlock Text="Endirim:" Margin="15,0,0,0"/><TextBox Text="{Binding Discount,UpdateSourceTrigger=PropertyChanged}" Width="80"/><TextBlock Text="Ödənilən:"/><TextBox Text="{Binding Paid,UpdateSourceTrigger=PropertyChanged}" Width="80"/><TextBlock Text="Ümumi:" Margin="15,0,0,0"/><TextBlock Text="{Binding Total,StringFormat={}{0:N2} ₼}"/><TextBlock Text="Qalıq:" Margin="15,0,0,0"/><TextBlock Text="{Binding Change,StringFormat={}{0:N2} ₼}"/><Button Content="Satışı tamamla" Command="{Binding CompleteCommand}"/></WrapPanel></Border></Grid></DataTemplate>
<DataTemplate DataType="{x:Type vm:PurchaseVm}"><StackPanel><TextBlock Text="Alış" FontSize="28"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name"/><TextBox Text="{Binding Quantity}"/><TextBox Text="{Binding Price}"/><Button Content="Alışı yadda saxla" Command="{Binding SaveCommand}"/></StackPanel></DataTemplate>
<DataTemplate DataType="{x:Type vm:FinanceVm}"><StackPanel><TextBlock Text="Gəlir / Xərc" FontSize="28"/><DataGrid ItemsSource="{Binding Expenses}"><DataGrid.Columns><DataGridTextColumn Header="Xərc" Binding="{Binding Description}"/><DataGridTextColumn Header="Məbləğ" Binding="{Binding Amount}"/></DataGrid.Columns></DataGrid><TextBox Text="{Binding Form.Description}" ToolTip="Xərc adı"/><TextBox Text="{Binding Form.Amount}" ToolTip="Məbləğ"/><Button Content="Xərc əlavə et" Command="{Binding SaveCommand}"/></StackPanel></DataTemplate>
<DataTemplate DataType="{x:Type vm:ReportsVm}"><ScrollViewer><StackPanel><TextBlock Text="Hesabatlar" FontSize="28" FontWeight="Bold"/><WrapPanel><Button Content="Bugün" Command="{Binding PeriodCommand}" CommandParameter="Bugün"/><Button Content="Dünən" Command="{Binding PeriodCommand}" CommandParameter="Dünən"/><Button Content="Bu həftə" Command="{Binding PeriodCommand}" CommandParameter="Bu həftə"/><Button Content="Bu ay" Command="{Binding PeriodCommand}" CommandParameter="Bu ay"/><Button Content="Keçən ay" Command="{Binding PeriodCommand}" CommandParameter="Keçən ay"/><DatePicker SelectedDate="{Binding From}"/><DatePicker SelectedDate="{Binding To}"/><Button Content="Xüsusi tarixi yenilə" Command="{Binding RefreshCommand}"/></WrapPanel><UniformGrid Columns="3"><TextBlock Text="{Binding Sales,StringFormat=Ümumi satış: {0:N2} ₼}" Margin="10" FontSize="18"/><TextBlock Text="{Binding Purchases,StringFormat=Ümumi alış: {0:N2} ₼}" Margin="10" FontSize="18"/><TextBlock Text="{Binding CostOfGoods,StringFormat=Satışın maya dəyəri: {0:N2} ₼}" Margin="10" FontSize="18"/><TextBlock Text="{Binding Gross,StringFormat=Brüt mənfəət: {0:N2} ₼}" Margin="10" FontSize="18"/><TextBlock Text="{Binding Expenses,StringFormat=Digər xərclər: {0:N2} ₼}" Margin="10" FontSize="18"/><TextBlock Text="{Binding Net,StringFormat=Xalis mənfəət: {0:N2} ₼}" Margin="10" FontSize="18"/><TextBlock Text="{Binding SaleCount,StringFormat=Satış sayı: {0}}" Margin="10"/><TextBlock Text="{Binding ProductsSold,StringFormat=Satılan məhsul sayı: {0}}" Margin="10"/></UniformGrid><TextBlock Text="Ən çox satılan məhsullar" FontSize="20"/><DataGrid ItemsSource="{Binding BestSellers}"><DataGrid.Columns><DataGridTextColumn Header="Məhsul" Binding="{Binding Name}"/><DataGridTextColumn Header="Say" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Satış" Binding="{Binding Amount,StringFormat={}{0:N2} ₼}"/></DataGrid.Columns></DataGrid><TextBlock Text="Ən gəlirli məhsullar" FontSize="20"/><DataGrid ItemsSource="{Binding ProfitableProducts}"><DataGrid.Columns><DataGridTextColumn Header="Məhsul" Binding="{Binding Name}"/><DataGridTextColumn Header="Say" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Mənfəət" Binding="{Binding Amount,StringFormat={}{0:N2} ₼}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding ProductCount,StringFormat=Ümumi məhsul: {0}}"/><TextBlock Text="{Binding StockQuantity,StringFormat=Ümumi stok miqdarı: {0}}"/><TextBlock Text="{Binding LowStock,StringFormat=Kritik stok: {0}}"/><TextBlock Text="{Binding OutOfStock,StringFormat=Stokda yoxdur: {0}}"/></StackPanel></ScrollViewer></DataTemplate>
<DataTemplate DataType="{x:Type vm:SettingsVm}"><StackPanel><TextBlock Text="Ayarlar" FontSize="28" FontWeight="Bold"/><TextBlock Text="Mağaza adı"/><TextBox Text="{Binding StoreName}" Width="380"/><CheckBox Content="Mənfi stoka icazə ver" IsChecked="{Binding AllowNegativeStock}" Margin="5"/><Button Content="Ayarları yadda saxla" Command="{Binding SaveCommand}"/><TextBlock Text="Verilənlər bazası yolu" Margin="5,20,5,0"/><TextBox Text="{Binding DatabasePath}" IsReadOnly="True" Width="600"/><TextBlock Text="Backup üçün bu bazanın surəti yaradılır."/><Button Content="Database backup" Command="{Binding BackupCommand}"/><Button Content="Backup restore" Background="#DC2626" Command="{Binding RestoreCommand}"/></StackPanel></DataTemplate>
</Application.Resources></Application>
